<!doctype html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] ?? "Bruno Martins — Desenvolvedor Full Stack")</title>
    <meta name="description" content="Portfólio de Bruno Martins, Desenvolvedor Full Stack especializado em C#, ASP.NET, SQL Server e JavaScript." />
    <meta name="theme-color" content="#12202b" />
    <meta property="og:title" content="Bruno Martins — Desenvolvedor Full Stack" />
    <meta property="og:description" content="Sistemas web, dados, regras de negócio e soluções empresariais." />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="~/img/mark.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body data-scroll-to="@ViewData["ScrollTo"]">
    @RenderBody()
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
